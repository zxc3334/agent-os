# 飞书自建应用凭证（接入飞书那一篇手把手教你创建）
BOT_A_APP_ID=cli_xxx
BOT_A_APP_SECRET=xxx

# 新话题默认使用的执行引擎：claude 或 codex
DEFAULT_CLI=claude

# AI 编程 CLI 执行任务的项目目录，默认是 Agent OS 当前目录
CLI_WORKDIR=

# Claude Code / Codex 的模型后端使用各自的用户级配置管理
# 也可以使用 CC Switch 在不同模型服务之间切换

# 可选：Codex 专用代理（不影响飞书直连）。
# Codex 依赖 OpenAI 后端（chatgpt.com），网络受限时需要配置；
# 只注入到 codex 子进程，agent-os 主进程（飞书）保持直连。
CODEX_PROXY=
